APP_NAME=AUTOSECURE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autosecure
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=sessions

# Admin portal (/manage) uses its own session cookie so that an admin session
# and a customer session can coexist in the same browser.
MANAGE_SESSION_COOKIE=autosecure_manage_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@autosecure.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AUTOSECURE 2.0
# ---------------------------------------------------------------------------
# Mobile API
API_PREFIX=api
API_VERSION=v1

# Sanctum token lifetime in minutes (null = never expires)
SANCTUM_TOKEN_LIFETIME=43200

# Comma separated list of hosts allowed to call device/provider webhooks.
DEVICE_WEBHOOK_ALLOWED_HOSTS=

# Provider integrations are PENDING until AUTOSECURE supplies SDK/API docs.
# Supported drivers: "null" (no integration wired yet).
TRACKER_DRIVER=null
DASHCAM_DRIVER=null
AUTODOC_DRIVER=null
PAYMENT_DRIVER=null

TRACKER_BASE_URL=
TRACKER_API_KEY=
TRACKER_API_SECRET=

DASHCAM_BASE_URL=
DASHCAM_APP_KEY=
DASHCAM_APP_SECRET=

AUTODOC_BASE_URL=
AUTODOC_CLIENT_ID=
AUTODOC_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
