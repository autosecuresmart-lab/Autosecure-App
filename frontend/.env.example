# AUTOSECURE mobile app — configuration
#
# Copy to `.env` and adjust. Expo inlines EXPO_PUBLIC_* values at build time, so
# NEVER put a secret in this file. Device provider credentials, payment keys and
# signing secrets live only on the Laravel backend.

# Base URL of the AUTOSECURE API, including the version segment.
#   iOS simulator      -> http://localhost:8000/api/v1   (default)
#   Android emulator   -> http://10.0.2.2:8000/api/v1    (default)
#   Physical device    -> http://<your-lan-ip>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# development | staging | production
EXPO_PUBLIC_APP_ENV=development
